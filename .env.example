# Copy to `.env` and fill in. Vite exposes only VITE_-prefixed vars to the client.

# Optional: override the API base URL (defaults to localhost:8080/api in dev,
# the Cloud Run URL in production).
# VITE_API_BASE_URL=http://localhost:8080/api

# Web Push (FCM) public VAPID key — REQUIRED for browser push notifications.
# Generate once: Firebase Console → project tsangpool-honda-otp → Project Settings
# → Cloud Messaging → "Web Push certificates" → Generate key pair → copy the key.
# Without this, the app still works but push registration is skipped.
VITE_FIREBASE_VAPID_KEY=BJaeCDq3A-YGUSUrzWQ5rj3T_NbBEDBbCQSxhjwrtmtsIVEP1NYiI52kJRlJZ-0OfS7R22JYCVC4nl-jeQsu72I
VITE_RECAPTCHA_SITE_KEY=6Ldc7HktAAAAAKUYMj_giK5HJvf8kajtDuZ1oyQA